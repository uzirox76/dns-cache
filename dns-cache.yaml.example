listen: ":53"

upstreams:
  - "1.1.1.1:53"
  - "9.9.9.9:53"
  - "8.8.8.8:53"

cache:
  ttl_min: 60
  ttl_max: 86400
  refresh_interval: 30
  stale_serving: true
  max_entries: 10000
  # Past its TTL an answer is still served instantly, and re-resolved in the
  # background right away, as long as it is younger than max_age seconds.
  # 0 = never serve past TTL.
  max_age: 1800
  # Usual domains are kept fresh in the background even while idle: those
  # asked for on at least keep_min_days of the last keep_window_days (max 32).
  keep_min_days: 2
  keep_window_days: 7

persistence:
  db_path: "/var/cache/dns-cache/cache.db"
  # Never shorter than keep_window_days, or the usage history would be lost.
  cleanup_after_hours: 48

stats:
  socket_path: "/var/run/dns-cache.sock"

web:
  listen: ":8053"
